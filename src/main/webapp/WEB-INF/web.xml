<?xml version="1.0" encoding="UTF-8"?>

<web-app
        xmlns="http://xmlns.jcp.org/xml/ns/javaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://xmlns.jcp.org/xml/ns/javaee
        http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
        version="4.0">

    <display-name>RashikMart</display-name>

    <!-- ============================= -->
    <!-- Database Context Listener      -->
    <!-- ============================= -->

    <listener>
        <listener-class>
            com.rashik.rashikmart.config.DatabaseContextListener
        </listener-class>
    </listener>


    <!-- ============================= -->
    <!-- Authentication Filter          -->
    <!-- ============================= -->

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>
            com.rashik.rashikmart.filter.AuthFilter
        </filter-class>
    </filter>

    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/buyer/*</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/seller/*</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>


    <!-- ============================= -->
    <!-- Session Configuration          -->
    <!-- ============================= -->

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>