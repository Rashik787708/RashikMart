# ============================================================
# RashikMart environment variables
#
# Copy this file to your own environment configuration. Do NOT
# commit real values. This file is only documentation: the app
# reads these values from the actual environment (system env /
# Render dashboard), not from this file.
# ============================================================

# ------------------------------------------------------------
# Database backend selection
#   h2       -> local development (Windows, H2, no setup needed)
#   postgres -> Render production (Render PostgreSQL)
# ------------------------------------------------------------
# On Render:
#   DB_TYPE=postgres
DB_TYPE=h2

# ------------------------------------------------------------
# LOCAL H2 (optional overrides; the defaults below already work)
#   DB_URL      -> default jdbc:h2:./data/rashikmart
#   DB_USER     -> default sa
#   DB_PASSWORD -> default WE
# ------------------------------------------------------------
DB_URL=jdbc:h2:./data/rashikmart
DB_USER=sa
DB_PASSWORD=

# ------------------------------------------------------------
# PostgreSQL (leave blank locally)
#   Set DB_TYPE=postgres and paste a full connection URL. Works
#   with Render's own database or a free external provider:
#     Neon     -> postgresql://user:pass@ep-xxx.aws.neon.tech/db?sslmode=require
#     Supabase -> postgresql://postgres.<ref>:pass@aws-0-<region>.pooler.supabase.com:6543/postgres
# ------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------
# Product image uploads (optional)
#   On Render, point this at a persistent disk mount if you
#   want seller-uploaded photos to survive restarts, e.g.:
#   RASHIKMART_UPLOAD_DIR=/var/data/product-images
# ------------------------------------------------------------
RASHIKMART_UPLOAD_DIR=

# ------------------------------------------------------------
# Seeded Admin Account (optional override)
# ------------------------------------------------------------
ADMIN_PASSWORD=admin123

# ------------------------------------------------------------
# AI Chatbot Configuration (spec §11, §17)
#   AI_CHATBOT_PROVIDER: mock (default, offline deterministic) or gemini
#   GEMINI_API_KEY: Google Gemini API key (only if gemini provider used)
#   GEMINI_MODEL: default gemini-3.1-flash-lite (do NOT use deprecated 2.5)
# ------------------------------------------------------------
AI_CHATBOT_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite